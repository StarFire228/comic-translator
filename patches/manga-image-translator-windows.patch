+    @staticmethod
+    def _sentence_case(text: str) -> str:
+        """Comic lettering is often ALL CAPS and the model then answers in caps too: convert to normal case."""
+        letters = [c for c in text if c.isalpha()]
+        if len(letters) < 4 or sum(c.isupper() for c in letters) < 0.8 * len(letters):
+            return text
+        text = text.lower()
+        text = re.sub(r'(^|[.!?…]\s+|["“«(]\s*)([a-z])', lambda m: m.group(1) + m.group(2).upper(), text)
+        return re.sub(r"\bi\b", 'I', text)
+
     async def _translate(self, from_lang: str, to_lang: str, queries: List[str]) -> List[str]:
         translations = []
         self.logger.debug(f'Temperature: {self.temperature}, TopP: {self.top_p}')
