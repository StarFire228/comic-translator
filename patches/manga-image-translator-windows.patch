index 0000000..556f07d
--- /dev/null
+++ b/manga_translator/text_colors.py
@@ -0,0 +1,53 @@
+"""Take the text colour from the original page instead of the OCR model's guess.
+
+The OCR model's colour estimate is unreliable on comic lettering (a white title on a pink
+banner sometimes came out black with a white outline). We compare the original page with the
+inpainted one: the pixels the inpainter changed inside a text block are the old lettering
+(fill + outline). The fill is the part that differs most from the block's background, so we take
+the median colour of the most background-unlike pixels, and give it a contrasting outline.
+"""
+import logging
+
+import cv2
+import numpy as np
+
+logger = logging.getLogger('manga_translator.text_colors')
+
+
+def _luma(c):
+    return 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2]
+
+
+def refine_colors(original: np.ndarray, inpainted: np.ndarray, regions) -> None:
+    if original is None or inpainted is None or original.shape != inpainted.shape:
+        return
+    h, w = original.shape[:2]
+    for region in regions:
+        try:
+            x1, y1, x2, y2 = [int(v) for v in region.xyxy]
+            x1, y1, x2, y2 = max(x1, 0), max(y1, 0), min(x2, w), min(y2, h)
+            if x2 - x1 < 4 or y2 - y1 < 4:
+                continue
+            o = original[y1:y2, x1:x2, :3].astype(np.float32)
+            p = inpainted[y1:y2, x1:x2, :3].astype(np.float32)
+            changed = np.abs(o - p).max(axis=2) > 50
+            if changed.sum() < 30:
+                continue
+            bg = np.median(p.reshape(-1, 3), axis=0)
+            # Lettering = fill inside the strokes + outline around them. Eroding the changed-pixel
+            # mask keeps the middle of the strokes (the fill); what erosion removed is the outline.
+            mask = changed.astype(np.uint8)
+            inner = cv2.erode(mask, np.ones((3, 3), np.uint8), iterations=2).astype(bool)
+            edge = changed & ~inner
+            px = o[inner] if inner.sum() >= 30 else o[changed]
+            dist = np.linalg.norm(px - bg, axis=1)
+            fg = np.median(px[dist >= np.percentile(dist, 50)], axis=0)
+            if np.linalg.norm(fg - bg) < 60:
+                continue  # too close to the background to be sure — keep the OCR colour
+            stroke = np.median(o[edge], axis=0) if edge.sum() >= 30 else None
+            if stroke is None or np.linalg.norm(stroke - fg) < 90:
+                # no distinct outline in the original — pick one that contrasts with the fill
+                stroke = np.array([0, 0, 0]) if _luma(fg) >= 80 else np.array([255, 255, 255])
+            region.set_font_colors(fg.round().astype(int), np.asarray(stroke).round().astype(int))
+        except Exception as e:  # never break rendering because of colour sampling
+            logger.debug(f'colour sampling skipped: {e}')
