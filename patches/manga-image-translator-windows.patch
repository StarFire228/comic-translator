+def _same_background_limit(img, dst_points, limit_y):
+    """How far down the box may grow while the area below looks like the box's own background.
+
+    Text boxes in comics are often framed (bubble outline, caption frame): growing past the frame
+    puts text over the border or the artwork. We walk down row by row under the box and stop at the
+    first row that is not a plain continuation of the background (a border line, a colour change,
+    a busy picture). Plain backgrounds (cards, page margins) still let the box grow.
+    """
+    pts = dst_points.reshape(4, 2)
+    x1, x2 = int(max(pts[:, 0].min(), 0)), int(min(pts[:, 0].max(), img.shape[1]))
+    y1, y2 = int(max(pts[:, 1].min(), 0)), int(min(pts[:, 1].max(), img.shape[0]))
+    if x2 - x1 < 8 or y2 - y1 < 4 or y2 >= limit_y:
+        return limit_y
+    # inner 80% of the width: the box edges may touch the frame's side borders
+    mx = (x2 - x1) // 10
+    xs, xe = x1 + mx, x2 - mx
+    inside = img[y1:y2, xs:xe, :3].reshape(-1, 3).astype(np.float32)
+    ref = np.median(inside, axis=0)
+    prev = ref
+    for y in range(y2, int(limit_y)):
+        row = img[y, xs:xe, :3].astype(np.float32)
+        mean = row.mean(axis=0)
+        if row.std(axis=0).max() > 22 or np.abs(mean - ref).max() > 40 or np.abs(mean - prev).max() > 14:
+            return max(y - 2, y2)
+        prev = mean
+    return limit_y
+
+
+def _max_box_height(dst_points, img_h):
+    """Height the box may reach if its bottom edge is moved down to the image edge."""
+    pts = dst_points.reshape(4, 2).astype(np.float64)  # TL, TR, BR, BL
+    side = pts[3] - pts[0]
+    box_h = np.linalg.norm(side)
+    if box_h < 1:
+        return box_h
+    down = side / box_h
+    if down[1] <= 1e-3:
+        return box_h
+    room = (img_h - 1 - max(pts[2][1], pts[3][1])) / down[1]
+    return box_h + max(room, 0)
+
+def _extend_box_down(dst_points, text_w, text_h, img_h):
+    """Lengthen the box's left/right edges so text_w x text_h fits at its width, staying inside the image."""
+    pts = dst_points.reshape(4, 2).astype(np.float64)  # TL, TR, BR, BL
+    top = pts[1] - pts[0]
+    side = pts[3] - pts[0]
+    box_w = np.linalg.norm(top)
+    box_h = np.linalg.norm(side)
+    if box_w < 1 or box_h < 1:
+        return dst_points
+    need_h = text_h * box_w / text_w
+    if need_h <= box_h:
+        return dst_points
+    down = side / box_h
+    if down[1] > 1e-3:
+        # how far the lower corners may move before leaving the image
+        room = (img_h - 1 - max(pts[2][1], pts[3][1])) / down[1]
+        need_h = min(need_h, box_h + max(room, 0))
+    pts[3] = pts[0] + down * need_h
+    pts[2] = pts[1] + down * need_h
+    return pts.reshape(dst_points.shape).astype(dst_points.dtype)
