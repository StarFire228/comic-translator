+def _similar_text_colour(a: Quadrilateral, b: Quadrilateral, max_diff: int = 220) -> bool:
+    """White title vs black quote: different captions even if they touch.
+
+    max_diff is the summed R+G+B difference of the text colours (white vs black = 765)."""
+    try:
+        diff = abs(a.fg_r - b.fg_r) + abs(a.fg_g - b.fg_g) + abs(a.fg_b - b.fg_b)
+    except (AttributeError, TypeError):
+        return True
+    return diff <= max_diff
