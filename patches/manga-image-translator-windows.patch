diff --git a/manga_translator/vlm_ocr.py b/manga_translator/vlm_ocr.py
new file mode 100644
index 0000000..fe1d7c4
--- /dev/null
+++ b/manga_translator/vlm_ocr.py
@@ -0,0 +1,82 @@
+"""Re-read detected text blocks with a vision LLM (e.g. gemma3 via Ollama).
+
+The built-in OCR models lose spaces and whole lines on Latin comic lettering
+(tight kerning, outlined text). A vision model reads such crops almost verbatim.
+Enabled when the VLM_OCR_MODEL environment variable is set.
+"""
+import asyncio
+import base64
+import json
+import logging
+import os
+import urllib.request
+
+import cv2
+import numpy as np
+
+logger = logging.getLogger('manga_translator.vlm_ocr')
+
+PROMPT = ('Transcribe the text in this image exactly as written, as one paragraph '
+          '(join the lines with spaces). Output only the text. '
+          'If there is no readable text, output an empty line.')
+
+
+def enabled() -> bool:
+    return bool(os.getenv('VLM_OCR_MODEL'))
+
+
+def _api_base() -> str:
+    return os.getenv('VLM_OCR_API_BASE') or os.getenv('CUSTOM_OPENAI_API_BASE', 'http://127.0.0.1:11434/v1')
+
+
+def _crop(img: np.ndarray, region) -> np.ndarray:
+    x1, y1, x2, y2 = [int(v) for v in region.xyxy]
+    # small margin only: a big one picks up the neighbouring block's text
+    pad = min(12, max(4, int(region.font_size * 0.2))) if region.font_size > 0 else 8
+    h, w = img.shape[:2]
+    crop = img[max(0, y1 - pad):min(h, y2 + pad), max(0, x1 - pad):min(w, x2 + pad)]
+    # small lettering reads better when enlarged
+    if crop.shape[0] < 96:
+        scale = 96 / max(crop.shape[0], 1)
+        crop = cv2.resize(crop, None, fx=scale, fy=scale, interpolation=cv2.INTER_CUBIC)
+    return crop
+
+
+def _ask(crop_rgb: np.ndarray) -> str:
+    ok, png = cv2.imencode('.png', cv2.cvtColor(crop_rgb, cv2.COLOR_RGB2BGR))
+    if not ok:
+        return ''
+    body = {
+        'model': os.environ['VLM_OCR_MODEL'],
+        'temperature': 0,
+        'messages': [{'role': 'user', 'content': [
+            {'type': 'text', 'text': PROMPT},
+            {'type': 'image_url', 'image_url': {'url': 'data:image/png;base64,' + base64.b64encode(png.tobytes()).decode()}},
+        ]}],
+    }
+    req = urllib.request.Request(_api_base().rstrip('/') + '/chat/completions', json.dumps(body).encode(),
+                                 {'Content-Type': 'application/json',
+                                  'Authorization': 'Bearer ' + os.getenv('CUSTOM_OPENAI_API_KEY', 'ollama')})
+    with urllib.request.urlopen(req, timeout=180) as resp:
+        data = json.load(resp)
+    return ' '.join(data['choices'][0]['message']['content'].split())
+
+
+async def reread(img_rgb: np.ndarray, regions) -> None:
+    """Replace each region's OCR text with the vision model's reading (in place)."""
+    for region in regions:
+        try:
+            text = await asyncio.to_thread(_ask, _crop(img_rgb, region))
+        except Exception as e:
+            logger.warning(f'VLM OCR failed, keeping OCR text "{region.text}": {e}')
+            continue
+        text = text.strip().strip('`').strip()
+        # the vision model sees no text: drop the block (OCR noise on artwork)
+        if not text:
+            logger.info(f'VLM OCR: no text in "{region.text}", dropping block')
+            region.text = ''
+            region.text_raw = ''
+            continue
+        logger.info(f'VLM OCR: "{region.text}" -> "{text}"')
+        region.text = text
+        region.text_raw = text
